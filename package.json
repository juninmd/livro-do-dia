{
  "name": "livro-do-dia",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Bot diário de indicação de livros (resumo, sinopse, capa, curiosidades e link Amazon) via Telegram.",
  "scripts": {
    "dev": "bun run src/index.ts",
    "start": "bun run src/index.ts --loop",
    "post": "bun run src/index.ts --post",
    "preview": "bun run src/index.ts --preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome check --write ."
  },
  "dependencies": {
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "@types/bun": "^1.2.0",
    "@types/node-cron": "^3.0.11",
    "typescript": "^5.7.3"
  }
}
