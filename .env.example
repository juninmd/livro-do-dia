# IA — LiteLLM do cluster (compatível com OpenAI)
AI_PROVIDER=openai
OPENAI_BASE_URL=https://litellm.antonio-code.duckdns.org/v1
OPENAI_API_KEY=sk-...
OPENAI_MODEL=cloud/gemma3
AI_TIMEOUT_MS=60000
# cert self-signed do cluster (só em dev)
NODE_TLS_REJECT_UNAUTHORIZED=0

# Telegram (mesmo bot do evo-agent)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=

# Amazon Associados (opcional — sem tag o link vai sem comissão)
AMAZON_ASSOCIATE_TAG=

# Agenda do post diário (America/Sao_Paulo)
CRON_POST=0 8 * * *
DB_PATH=./data/store.db
